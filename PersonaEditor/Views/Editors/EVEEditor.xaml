<UserControl x:Class="PersonaEditor.Views.Editors.EVEEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StatusBar Grid.Row="0">
            <CheckBox Content="Enable Edit" IsChecked="{Binding IsEdit}" VerticalAlignment="Center"/>
            <Separator/>
            <TextBlock Text="Version"/>
            <TextBlock Text="{Binding FormatVersion}" Margin="4,0,10,0"/>
            <TextBlock Text="Code"/>
            <TextBlock Text="{Binding CodeTableEnd, StringFormat=0x{0:X4}}" Margin="4,0,10,0"/>
            <TextBlock Text="Strings"/>
            <TextBlock Text="{Binding Entries.Count}" Margin="4,0,0,0"/>
        </StatusBar>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Entries}"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.IsVirtualizing="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer CanContentScroll="True">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Index}" VerticalAlignment="Top" Margin="2,5,6,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Offset, StringFormat=0x{0:X4}}" VerticalAlignment="Top" Margin="2,5,6,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Top" Margin="2,5,6,0"/>
                        <TextBox Grid.Column="3"
                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsReadOnly="{Binding IsReadOnly}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
